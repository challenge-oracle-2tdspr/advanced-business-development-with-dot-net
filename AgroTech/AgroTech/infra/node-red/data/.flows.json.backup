        "name": "TokenSave",
        "func": "if (msg.payload && msg.payload.token) {\n  global.set(\"apiToken\", msg.payload.token);\n  global.set(\"apiTokenExpiresAt\", msg.payload.expiresAt || null);\n  node.status({ fill: \"green\", shape: \"dot\", text: \"token salvo\" });\n} else {\n  node.status({ fill: \"red\", shape: \"ring\", text: \"token não encontrado\" });\n  node.error(\"Resposta de login sem token\", msg);\n}\n\nreturn msg;",
