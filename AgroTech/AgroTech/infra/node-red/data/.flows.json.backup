    {
        "id": "b117747143839679",
        "type": "json",
        "z": "b44ab710a3bcd9ba",
        "name": "",
        "property": "payload",
        "action": "obj",
        "pretty": false,
        "x": 170,
        "y": 80,
        "wires": [
            [
                "07c6bef410112441"
            ]
        ]
    },
    {
        "id": "07c6bef410112441",
        "type": "function",
        "z": "b44ab710a3bcd9ba",
        "name": "Função ",
        "func": "let data = msg.payload;\n\nglobal.set('ultimoDadoSensor', data);\n\nlet agora = new Date().toISOString();\n\nfunction toNumber(v) {\n    const n = Number(v);\n    return Number.isFinite(n) ? n : 0;\n}\n\n// Converte ADC do sensor de umidade do solo para porcentagem\n// ADC 0    = 100%\n// ADC 4095 = 0%\nfunction umidadeSoloPercentual(adc) {\n    const valor = toNumber(adc);\n\n    let percentual = 100 - ((valor / 4095) * 100);\n\n    percentual = Math.max(0, Math.min(100, percentual));\n\n    return Number(percentual.toFixed(1));\n}\n\nlet temperaturaAr = toNumber(data.temperatura_ar);\nlet umidadeAr = toNumber(data.umidade_ar);\nlet umidadeSolo = umidadeSoloPercentual(data.umidade_solo);\nlet luminosidade = toNumber(data.luminosidade);\n\n// =========================\n// DASHBOARD\n// =========================\n\nlet msgTempAr = {\n    payload: temperaturaAr\n};\n\nlet msgUmidAr = {\n    payload: umidadeAr\n};\n\nlet msgUmidSolo = {\n    payload: umidadeSolo\n};\n\nlet msgLuminosidade = {\n    payload: luminosidade\n};\n\n// =========================\n// API\n// =========================\n\nlet headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nlet token = global.get(\"apiToken\");\n\nif (token) {\n    headers[\"Authorization\"] = \"Bearer \" + token;\n}\n\nlet msgHttp = {\n    payload: [\n        {\n            name: \"Temperatura do Ar\",\n            type: \"11\",\n            value: temperaturaAr,\n            timestamp: agora\n        },\n        {\n            name: \"Umidade do Ar\",\n            type: \"12\",\n            value: umidadeAr,\n            timestamp: agora\n        },\n        {\n            name: \"Umidade do Solo\",\n            type: \"13\",\n            value: umidadeSolo,\n            timestamp: agora\n        },\n        {\n            name: \"Luminosidade\",\n            type: \"15\",\n            value: luminosidade,\n            timestamp: agora\n        }\n    ],\n    headers: headers\n};\n\nreturn [\n    msgTempAr,\n    msgUmidAr,\n    msgUmidSolo,\n    msgLuminosidade,\n    msgHttp\n];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 220,
        "wires": [
            [
                "9b2d2af417c26b30"
            ],
            [
                "e56ed5c3425c7872"
            ],
            [
                "b625339f22554e96"
            ],
            [
                "b99c37b89e3dd59c"
            ],
            [
                "1adcd2db54875017"
            ]
        ]
    },
