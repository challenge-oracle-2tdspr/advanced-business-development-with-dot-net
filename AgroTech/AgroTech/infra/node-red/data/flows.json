    {
        "id": "07c6bef410112441",
        "type": "function",
        "z": "b44ab710a3bcd9ba",
        "name": "Função ",
        "func": "let data = msg.payload;\n\nglobal.set('ultimoDadoSensor', data);\n\nlet agora = new Date().toISOString();\n\nfunction toNumber(v) {\n    const n = Number(v);\n    return Number.isFinite(n) ? n : 0;\n}\n\nlet msgTempAr = { payload: toNumber(data.temperatura_ar) };\nlet msgUmidAr = { payload: toNumber(data.umidade_ar) };\nlet msgUmidSolo = { payload: toNumber(data.umidade_solo) };\nlet msgPhSolo = { payload: toNumber(data.ph_solo) };\nlet msgLuminosidade = { payload: toNumber(data.luminosidade) };\nlet msgVelocidadeVento = { payload: toNumber(data.velocidade_vento) };\nlet msgChuva = { payload: toNumber(data.chuva) };\nlet msgTempSolo = { payload: toNumber(data.temperatura_solo) };\n\nlet msgHttp = {\n    payload: [\n        {\n            name: \"Temperatura do Ar\",\n            type: \"11\",\n            value: toNumber(data.temperatura_ar),\n            timestamp: agora\n        },\n        {\n            name: \"Umidade do Ar\",\n            type: \"12\",\n            value: toNumber(data.umidade_ar),\n            timestamp: agora\n        },\n        {\n            name: \"Umidade do Solo\",\n            type: \"13\",\n            value: toNumber(data.umidade_solo),\n            timestamp: agora\n        },\n        {\n            name: \"pH do Solo\",\n            type: \"14\",\n            value: toNumber(data.ph_solo),\n            timestamp: agora\n        },\n        {\n            name: \"Luminosidade\",\n            type: \"15\",\n            value: toNumber(data.luminosidade),\n            timestamp: agora\n        },\n        {\n            name: \"Velocidade do Vento\",\n            type: \"16\",\n            value: toNumber(data.velocidade_vento),\n            timestamp: agora\n        },\n        {\n            name: \"Chuva\",\n            type: \"17\",\n            value: toNumber(data.chuva),\n            timestamp: agora\n        },\n        {\n            name: \"Temperatura do Solo\",\n            type: \"18\",\n            value: toNumber(data.temperatura_solo),\n            timestamp: agora\n        }\n    ],\n    headers: {\n        \"Content-Type\": \"application/json\"\n    }\n};\n\nreturn [\n    msgTempAr,\n    msgUmidAr,\n    msgUmidSolo,\n    msgPhSolo,\n    msgLuminosidade,\n    msgVelocidadeVento,\n    msgChuva,\n    msgTempSolo,\n    msgHttp\n];",
        "outputs": 9,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
