    {
        "id": "07c6bef410112441",
        "type": "function",
        "z": "b44ab710a3bcd9ba",
        "name": "Função ",
        "func": "let data = msg.payload;\n\nglobal.set('ultimoDadoSensor', data);\n\nlet agora = new Date().toISOString();\n\nlet msgTempAr = { payload: Number(data.temperatura) };\nlet msgUmidAr = { payload: Number(data.umidade) };\nlet msgUmidSolo = { payload: Number(data.co) };\nlet msgPhSolo = { payload: Number(data.co2) };\nlet msgLuminosidade = { payload: Number(data.ch4) };\nlet msgVelocidadeVento = { payload: Number(data.h2s) };\nlet msgChuva = { payload: Number(data.chuva) };\nlet msgTempSolo = { payload: Number(data.temperatura_solo) };\n\nlet msgHttp = {\n    payload: [\n        {\n            name: \"Temperatura do Ar\",\n            type: \"11\",\n            value: Number(data.temperatura),\n            timestamp: agora\n        },\n        {\n            name: \"Umidade do Ar\",\n            type: \"12\",\n            value: Number(data.umidade),\n            timestamp: agora\n        },\n        {\n            name: \"Umidade do Solo\",\n            type: \"13\",\n            value: Number(data.co),\n            timestamp: agora\n        },\n        {\n            name: \"pH do Solo\",\n            type: \"14\",\n            value: Number(data.co2),\n            timestamp: agora\n        },\n        {\n            name: \"Luminosidade\",\n            type: \"15\",\n            value: Number(data.ch4),\n            timestamp: agora\n        },\n        {\n            name: \"Velocidade do Vento\",\n            type: \"16\",\n            value: Number(data.h2s),\n            timestamp: agora\n        },\n        {\n            name: \"Chuva\",\n            type: \"17\",\n            value: Number(data.chuva),\n            timestamp: agora\n        },\n        {\n            name: \"Temperatura do Solo\",\n            type: \"18\",\n            value: Number(data.temperatura_solo),\n            timestamp: agora\n        }\n    ]\n};\n\nreturn [\n    msgTempAr,\n    msgUmidAr,\n    msgUmidSolo,\n    msgPhSolo,\n    msgLuminosidade,\n    msgVelocidadeVento,\n    msgChuva,\n    msgTempSolo,\n    msgHttp\n];",
